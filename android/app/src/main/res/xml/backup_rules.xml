<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Index FTS bisa dibangun ulang (backfill); jangan ikut backup. -->
    <exclude domain="file" path="arka_session_index.db" />
    <exclude domain="file" path="arka_session_index.db-journal" />
    <exclude domain="file" path="arka_session_index.db-wal" />
    <!-- Workspace bisa besar + berisi file user (termasuk lampiran biner). -->
    <exclude domain="file" path="workspace/" />
    <!-- File temp/backup internal. -->
    <exclude domain="file" path="proot-tmp/" />
    <!-- Rootfs Alpine: berisi /root/.git-credentials (PAT GitHub plaintext)
         dan /root/.gitconfig — TIDAK boleh ikut backup. -->
    <exclude domain="file" path="distro/" />
    <!-- Folder sesi lama (layout pre-migrasi, VirtualFs) + data virtual_fs:
         berkas kerja sesi lama yang bisa memuat rahasia/kredensial tertinggal.
         (Sesi baru di <filesDir>/workspace/ sudah tercakup eksklusi
         workspace/ di atas.) -->
    <exclude domain="file" path="sessions/" />
    <exclude domain="file" path="virtual_fs/" />
    <!-- Transkrip chat sebenarnya disimpan di DataStore arka_state
         (datastore/), bukan di sessions/ — bisa memuat rahasia dari
         percakapan, jadi ikut dieksklusi. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
