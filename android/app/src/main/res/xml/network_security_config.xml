<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: LARANG cleartext (http). API key / PAT GitHub / isi percakapan
         hanya boleh dikirim lewat TLS. (Menggantikan android:usesCleartextTraffic
         ="true" yang sebelumnya mengizinkan http global di seluruh aplikasi.) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pengecualian loopback SAJA — bukan lalu lintas lintas-jaringan:
         - layanan exec lokal aplikasi (http://localhost:3399/exec, lihat
           Persistence.Prefs.execUrl), dan
         - loopback host dari emulator Android (10.0.2.2).
         Catatan: IP LAN/Tailscale arbitrer (mis. http://100.x.x.x:11434 untuk
         server Ollama) TIDAK bisa di-allowlist di sini (tidak ada dukungan
         CIDR/wildcard IP). Untuk tetap MEMPERTAHANKAN kebijakan ketat ini,
         http ke host privat di-relay lewat loopback oleh net/LocalForwarder
         (socket TCP mentah ke IP asli — kebijakan cleartext hanya ditegakkan
         oleh stack HTTP, bukan kernel), jadi cleartext langsung ke IP privat
         tidak perlu diizinkan di sini. http ke host PUBLIK tetap diblokir. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>localhost</domain>
        <domain>127.0.0.1</domain>
        <domain>::1</domain>
        <domain>10.0.2.2</domain>
    </domain-config>
</network-security-config>
